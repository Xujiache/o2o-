# Production compose example. Copy to deploy/.env.prod and replace every change_me value.
# Do not commit deploy/.env.prod.

O2O_SERVER_TAG=latest

APP_BASE_URL=https://o2o.example.com
GATEWAY_PUBLIC_BASE_URL=https://o2o.example.com
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
MYSQL_DATABASE=o2o
MYSQL_USER=o2o
MYSQL_PASSWORD=change_me_mysql_password

REDIS_PASSWORD=change_me_redis_password
REDIS_DB=0

MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change_me_mongo_root_password
MONGO_DATABASE=o2o

MINIO_ROOT_USER=change_me_minio_user
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_REGION=us-east-1
MINIO_BUCKET=o2o-prod
MINIO_PUBLIC_BASE_URL=https://o2o.example.com/minio

JWT_CUSTOMER_SECRET=change_me_customer_jwt_secret
JWT_MERCHANT_SECRET=change_me_merchant_jwt_secret
JWT_RIDER_SECRET=change_me_rider_jwt_secret
JWT_ADMIN_SECRET=change_me_admin_jwt_secret
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d
THIRD_PARTY_SECRET_KEY=change_me_32_byte_base64_key

INTEGRATION_MODE=mock
LOG_LEVEL=info
SWAGGER_ENABLED=false
