# 后端应用 .env(由 apps/server 加载;真实 .env 严禁提交)
# 复制为 .env 并按需修改

# ===== 应用 =====
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# ===== 安全 =====
# 4 端 JWT secret 严格隔离;生产环境务必改成强随机串
JWT_CUSTOMER_SECRET=customer_dev_secret_change_me
JWT_MERCHANT_SECRET=merchant_dev_secret_change_me
JWT_RIDER_SECRET=rider_dev_secret_change_me
JWT_ADMIN_SECRET=admin_dev_secret_change_me
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d

# 第三方密钥加密主密钥(AES-256-GCM,32 字节 base64)
THIRD_PARTY_SECRET_KEY=please_replace_with_32_byte_base64_key

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
# 默认 3307,因 Windows 主机已装 MySQL 占用 3306
MYSQL_PORT=3307
MYSQL_USER=o2o
MYSQL_PASSWORD=o2o_dev
MYSQL_DATABASE=o2o

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=o2o_redis_dev
REDIS_DB=0

# ===== MongoDB =====
MONGO_URI=mongodb://o2o:o2o_mongo_dev@127.0.0.1:27017/o2o

# ===== MinIO / 对象存储 =====
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=o2o_minio_admin
MINIO_SECRET_KEY=o2o_minio_dev_pwd
MINIO_BUCKET=o2o-dev
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000

# ===== 第三方:阶段0 全部 Mock =====
INTEGRATION_MODE=mock
# 阶段切换到 real 时启用以下凭证(留空时拒启动)

# 高德
AMAP_KEY=
AMAP_SECRET=

# 微信支付(v3)
WXPAY_APP_ID=
WXPAY_MCH_ID=
WXPAY_API_V3_KEY=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_SERIAL_NO=

# 支付宝
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 个推
GETUI_APP_ID=
GETUI_APP_KEY=
GETUI_MASTER_SECRET=

# 阿里云短信
ALI_SMS_ACCESS_KEY_ID=
ALI_SMS_ACCESS_KEY_SECRET=
ALI_SMS_SIGN_NAME=

# 阿里云实名
ALI_REALNAME_ACCESS_KEY_ID=
ALI_REALNAME_ACCESS_KEY_SECRET=

# ===== 限流(可被 sys_config 覆盖) =====
THROTTLE_DEFAULT_TTL=60
THROTTLE_DEFAULT_LIMIT=60

# ===== 日志 =====
LOG_LEVEL=debug
LOG_PRETTY=true

# ===== Swagger =====
SWAGGER_ENABLED=true
SWAGGER_PATH=api-docs
