# 后端应用 .env(由 apps/server 加载;真实 .env 严禁提交)
# 复制为 .env 并按需修改

# ===== 应用 =====
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# ===== 安全 =====
# 4 端 JWT secret 严格隔离;生产环境务必改成强随机串
JWT_CUSTOMER_SECRET=customer_dev_secret_change_me
JWT_MERCHANT_SECRET=merchant_dev_secret_change_me
JWT_RIDER_SECRET=rider_dev_secret_change_me
JWT_ADMIN_SECRET=admin_dev_secret_change_me
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d

# 第三方密钥加密主密钥(AES-256-GCM,32 字节 base64)
THIRD_PARTY_SECRET_KEY=please_replace_with_32_byte_base64_key

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
# 默认 3307,因 Windows 主机已装 MySQL 占用 3306
MYSQL_PORT=3307
MYSQL_USER=o2o
MYSQL_PASSWORD=o2o_dev
MYSQL_DATABASE=o2o

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=o2o_redis_dev
REDIS_DB=0

# ===== MongoDB =====
MONGO_URI=mongodb://o2o:o2o_mongo_dev@127.0.0.1:27017/o2o

# ===== MinIO / 对象存储 =====
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=o2o_minio_admin
MINIO_SECRET_KEY=o2o_minio_dev_pwd
MINIO_BUCKET=o2o-dev
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000

# ============================================================
# 第三方集成 — mock(默认开发用)/ real(凭证齐全才允许启动)
# 切到 real 时,若下方对应模块凭证为空,启动直接抛 MISCONFIGURED
# ============================================================
INTEGRATION_MODE=mock

# ----- 高德地图(开放平台 https://console.amap.com/) -----
# Web 服务 Key — 后端 restapi.amap.com 用
AMAP_WEB_SERVICE_KEY=
# (兼容旧名;新代码读 AMAP_WEB_SERVICE_KEY)
AMAP_KEY=
AMAP_SECRET=

# ----- 微信支付 V3(商户平台 https://pay.weixin.qq.com/) -----
# 商户号
WXPAY_MCH_ID=
# 小程序 / 公众号 / APP appid
WXPAY_APP_ID=
# APIv3 密钥(商户平台→账户中心→API 安全→APIv3 密钥)
WXPAY_API_V3_KEY=
# 商户 API 私钥 PEM 文件路径(apiclient_key.pem)
WXPAY_PRIVATE_KEY_PATH=
# 商户 API 证书序列号(apiclient_cert.pem 的 Serial)
WXPAY_CERT_SERIAL_NO=
# (兼容旧名;新代码读 WXPAY_CERT_SERIAL_NO)
WXPAY_SERIAL_NO=
# 异步回调地址(必须是 HTTPS,可被微信回调)
WXPAY_NOTIFY_URL=https://example.com/api/v1/callback/payments/wxpay

# ----- 支付宝(开放平台 https://open.alipay.com/) -----
ALIPAY_APP_ID=
# 应用私钥 PEM(开放平台→开发设置→接口加签方式→RSA2)
ALIPAY_PRIVATE_KEY=
# 支付宝公钥 PEM(用于验签)
ALIPAY_PUBLIC_KEY=
# 异步回调地址
ALIPAY_NOTIFY_URL=https://example.com/api/v1/callback/payments/alipay

# ----- 个推 GeTui(开发者中心 https://dev.getui.com/) -----
GETUI_APP_ID=
GETUI_APP_KEY=
GETUI_MASTER_SECRET=

# ----- 阿里云短信 DySmsApi(阿里云控制台 https://dysms.console.aliyun.com/) -----
ALI_SMS_ACCESS_KEY_ID=
ALI_SMS_ACCESS_KEY_SECRET=
# 签名(已审核通过)
ALI_SMS_SIGN_NAME=
# 登录验证码模板 code(已审核通过,如 SMS_xxxxxxx)
ALI_SMS_TEMPLATE_LOGIN=

# ----- 阿里云实人/实名(阿里云控制台 https://cloudauth.console.aliyun.com/) -----
ALI_REALNAME_AK=
ALI_REALNAME_SK=
# (兼容旧名;新代码读 ALI_REALNAME_AK/SK)
ALI_REALNAME_ACCESS_KEY_ID=
ALI_REALNAME_ACCESS_KEY_SECRET=

# ----- 微信小程序登录(公众平台 https://mp.weixin.qq.com/) -----
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
# (兼容旧名;新代码读 WECHAT_MP_APP_ID/SECRET)
WX_LOGIN_APP_ID=
WX_LOGIN_APP_SECRET=

# ===== 限流(可被 sys_config 覆盖) =====
THROTTLE_DEFAULT_TTL=60
THROTTLE_DEFAULT_LIMIT=60

# ===== 日志 =====
LOG_LEVEL=debug
LOG_PRETTY=true

# ===== Swagger =====
SWAGGER_ENABLED=true
SWAGGER_PATH=api-docs
