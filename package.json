{
  "name": "o2o-platform",
  "version": "0.0.1",
  "private": true,
  "description": "O2O 外卖+跑腿系统 — 商家端仅 Android/iOS APP;外卖与跑腿订单独立体系",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:server": "pnpm --filter @o2o/server dev",
    "dev:customer": "pnpm --filter @o2o/customer-app dev",
    "dev:customer:h5": "pnpm --filter @o2o/customer-app dev:h5",
    "dev:merchant": "pnpm --filter @o2o/merchant-app dev",
    "dev:rider": "pnpm --filter @o2o/rider-app dev",
    "dev:rider:h5": "pnpm --filter @o2o/rider-app dev:h5",
    "dev:admin": "pnpm --filter @o2o/admin-web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "migrate:run": "pnpm --filter @o2o/server migrate:run",
    "seed:run": "pnpm --filter @o2o/server seed:run",
    "docker:dev": "docker compose -f deploy/docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f deploy/docker-compose.dev.yml down",
    "format": "prettier --write \"**/*.{ts,tsx,js,vue,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,vue,json,md,yml,yaml}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.2"
  }
}
